{
  "name": "nest-graphql-example",
  "version": "0.0.1",
  "description": "Example of GraphQL with Nest.js and TypeORM ",
  "author": "Jaime Leonardo Suncin Cruz <leosuncin@gmail.com>",
  "private": true,
  "license": "GPL-3.0",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "db:create": "ts-node -r dotenv/config -r tsconfig-paths/register ./node_modules/typeorm-extension/dist/cli/index.js db:create -d src/config/orm.config",
    "db:drop": "ts-node -r dotenv/config -r tsconfig-paths/register ./node_modules/typeorm-extension/dist/cli/index.js db:drop -d src/config/orm.config",
    "db:seed": "ts-node -r dotenv/config -r tsconfig-paths/register ./node_modules/typeorm-extension/dist/cli/index.js seed -d src/config/orm.config",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "NODE_OPTIONS='-r dotenv/config' nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "typeorm": "NODE_OPTIONS='-r dotenv/config -r tsconfig-paths/register' typeorm-ts-node-commonjs -d src/config/orm.config"
  },
  "dependencies": {
    "@nestjs/apollo": "^10.0.14",
    "@nestjs/common": "^8.0.0",
    "@nestjs/config": "^2.1.0",
    "@nestjs/core": "^8.0.0",
    "@nestjs/graphql": "^10.0.15",
    "@nestjs/platform-express": "^8.0.0",
    "@nestjs/typeorm": "^8.1.0",
    "apollo-server-express": "^3.8.2",
    "graphql": "^16.5.0",
    "mysql2": "^2.3.0",
    "reflect-metadata": "^0.1.13",
    "rimraf": "^3.0.2",
    "rxjs": "^7.2.0",
    "typeorm": "^0.3.0"
  },
  "devDependencies": {
    "@nestjs/cli": "8.2.6",
    "@nestjs/schematics": "8.0.11",
    "@nestjs/testing": "8.4.7",
    "@types/express": "4.17.13",
    "@types/jest": "27.4.1",
    "@types/node": "16.11.38",
    "@types/supertest": "2.0.12",
    "@typescript-eslint/eslint-plugin": "5.62.0",
    "@typescript-eslint/parser": "5.62.0",
    "eslint": "8.17.0",
    "eslint-config-prettier": "8.10.2",
    "eslint-plugin-prettier": "4.2.5",
    "jest": "27.5.1",
    "jest-create-mock-instance": "2.0.0",
    "pactum": "3.1.9",
    "prettier": "2.6.2",
    "source-map-support": "0.5.21",
    "sqlite3": "5.1.7",
    "supertest": "6.2.3",
    "ts-jest": "27.1.5",
    "ts-loader": "9.6.1",
    "ts-node": "10.9.2",
    "tsconfig-paths": "3.14.1",
    "typeorm-extension": "2.8.1",
    "typescript": "4.7.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
